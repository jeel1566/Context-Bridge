{
    "manifest_version": 3,
    "name": "Context Bridge",
    "version": "1.0.0",
    "description": "Capture, store, and share context across AI conversations",
    "permissions": [
        "storage",
        "sidePanel",
        "activeTab",
        "identity",
        "scripting",
        "alarms"
    ],
    "host_permissions": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.anthropic.com/*",
        "https://czmpxzvcbwyxjhwrlgri.supabase.co/*",
        "https://context-bridge-api-dxfhdzabfqgrdhc2.eastus-01.azurewebsites.net/*"
    ],
    "background": {
        "service_worker": "src/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://chat.openai.com/*",
                "https://chatgpt.com/*",
                "https://claude.ai/*",
                "https://gemini.google.com/*"
            ],
            "js": [
                "src/content-scripts/platforms/base.js",
                "src/content-scripts/platforms/chatgpt.js",
                "src/content-scripts/platforms/claude.js",
                "src/content-scripts/platforms/gemini.js",
                "src/content-scripts/core/auto-discovery.js",
                "src/content-scripts/processors/content-extractor.js",
                "src/content-scripts/core/parser.js",
                "src/content-scripts/core/button-injector.js",
                "src/content-scripts/core/observer.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Context Bridge"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "oauth2": {
        "client_id": "799569526859-bc8smjo20jv7dih1vui7cd8k5v5i4l52.apps.googleusercontent.com",
        "scopes": [
            "openid",
            "email",
            "profile"
        ]
    },
    "key": ""
}